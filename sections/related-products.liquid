<section class="related-products-section">
  <div class="container">
    <div class="related-title-box">
      <div class="section-tag">{{ section.settings.subtitle | default: 'Related Products' }}</div>
      <h2 class="section-title">{{ section.settings.title | default: 'New Season.' }}</h2>
    </div>

    <div class="product-grid" style="grid-template-columns: repeat(3, 1fr); max-width: 960px; margin: 0 auto;">
      <!-- Card 1 -->
      <div class="product-card">
        <div class="card-media-wrap">
          <span class="card-badge" style="border-radius: 50%; width: 28px; height: 28px; padding: 0; display: flex; align-items: center; justify-content: center; font-size: 0.6rem;">SALE</span>
          <a href="/products/precision-eyeliner">
            <img src="{{ 'product-bottle-amber.svg' | asset_url }}" alt="Precision Eyeliner">
          </a>
          <div class="card-quick-actions">
            <button type="button" class="action-icon-btn wishlist" title="Wishlist">{% render 'icon-heart' %}</button>
            <button type="button" class="action-icon-btn quickview" title="Quick View">{% render 'icon-search' %}</button>
            <button type="button" class="action-icon-btn cart" title="Add to Cart">{% render 'icon-cart' %}</button>
          </div>
        </div>
        <div class="card-details">
          <h3 class="product-card-title"><a href="/products/precision-eyeliner">Precision Eyeliner</a></h3>
          <div class="card-prices">
            <span class="price-compare">$50.15</span>
            <span class="price-current">$40.07</span>
          </div>
          <div class="card-swatches">
            <span class="swatch-circle" style="background-color: #6a1b9a;"></span>
            <span class="swatch-circle" style="background-color: #1a1a1a;"></span>
            <span class="swatch-circle" style="background-color: #e53935;"></span>
          </div>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="product-card">
        <div class="card-media-wrap">
          <span class="card-badge" style="border-radius: 50%; width: 28px; height: 28px; padding: 0; display: flex; align-items: center; justify-content: center; font-size: 0.6rem;">SALE</span>
          <a href="/products/smoothing-essence">
            <img src="{{ 'product-bottle-rose.svg' | asset_url }}" alt="Smoothing Essence">
          </a>
          <div class="card-quick-actions">
            <button type="button" class="action-icon-btn wishlist" title="Wishlist">{% render 'icon-heart' %}</button>
            <button type="button" class="action-icon-btn quickview" title="Quick View">{% render 'icon-search' %}</button>
            <button type="button" class="action-icon-btn cart" title="Add to Cart">{% render 'icon-cart' %}</button>
          </div>
        </div>
        <div class="card-details">
          <h3 class="product-card-title"><a href="/products/smoothing-essence">Smoothing Essence</a></h3>
          <div class="card-prices">
            <span class="price-compare">$65.00</span>
            <span class="price-current">$50.67</span>
          </div>
          <div class="card-swatches">
            <span class="swatch-circle" style="background-color: #fdd835;"></span>
            <span class="swatch-circle" style="background-color: #f48fb1;"></span>
            <span class="swatch-circle" style="background-color: #1e88e5;"></span>
          </div>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="product-card">
        <div class="card-media-wrap">
          <a href="/products/modern-eye-brush">
            <img src="{{ 'product-bottle-amber.svg' | asset_url }}" alt="Modern Eye Brush">
          </a>
          <div class="card-quick-actions">
            <button type="button" class="action-icon-btn wishlist" title="Wishlist">{% render 'icon-heart' %}</button>
            <button type="button" class="action-icon-btn quickview" title="Quick View">{% render 'icon-search' %}</button>
            <button type="button" class="action-icon-btn cart" title="Add to Cart">{% render 'icon-cart' %}</button>
          </div>
        </div>
        <div class="card-details">
          <h3 class="product-card-title"><a href="/products/modern-eye-brush">Modern Eye Brush</a></h3>
          <div class="card-prices">
            <span class="price-current">$61.45</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Related Products",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Cursive Subtitle",
      "default": "Related Products"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "New Season."
    }
  ],
  "presets": [
    {
      "name": "Related Products"
    }
  ]
}
{% endschema %}
