{% comment %}
  Ultra-Luxury Full-Width Hero Banner Section
  - Full-width high-resolution background imagery
  - Centered minimalist editorial typography
  - Luxury gold accent and understated CTA button
  - Complete JSON schema customization
{% endcomment %}

<section
  class="luxury-hero-banner hero-height-{{ section.settings.section_height }}"
  data-section-id="{{ section.id }}"
  style="--overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  <!-- Background Image Media -->
  <div class="hero-bg-wrapper">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 2400 }}"
        alt="{{ section.settings.heading | escape }}"
        class="hero-bg-media"
        loading="eager"
      >
    {%- else -%}
      <div class="hero-bg-placeholder">
        <img src="{{ 'hero-beauty-model.svg' | asset_url }}" alt="Glow Luxury Skincare" class="hero-bg-media">
      </div>
    {%- endif -%}
    <div class="hero-bg-overlay"></div>
  </div>

  <!-- Centered Content -->
  <div class="luxury-container hero-container">
    <div class="hero-text-content text-align-{{ section.settings.text_alignment }}">
      {%- if section.settings.eyebrow != blank -%}
        <span class="hero-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="hero-main-title font-serif">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="hero-subtext">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="hero-action-row">
          <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="btn-luxury-cta">
            <span>{{ section.settings.button_label }}</span>
            <span class="cta-arrow">&rarr;</span>
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner (Luxury)",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Full-Width Background Image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Background Overlay Dimming",
      "default": 20
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section Height",
      "options": [
        { "value": "medium", "label": "Medium (600px)" },
        { "value": "large", "label": "Large (750px)" },
        { "value": "fullscreen", "label": "Full Screen (100vh)" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow / Subtitle",
      "default": "THE ART OF BOTANICAL RADIANCE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Cellular Vitality. Pure Luxury."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "High-potency clinical bio-actives engineered to restore elasticity, deep cellular hydration, and an ethereal natural glow."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "EXPLORE THE COLLECTION"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner (Luxury)"
    }
  ]
}
{% endschema %}
