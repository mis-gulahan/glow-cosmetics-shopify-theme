<section class="promo-banner">
  <div class="container promo-grid">
    <div class="promo-media">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 650 }}" alt="{{ section.settings.title | escape }}">
      {%- else -%}
        <img src="{{ 'body-care-banner.svg' | asset_url }}" alt="Body Care Product">
      {%- endif -%}
    </div>

    <div class="promo-content">
      <span class="feature-tag-badge">{{ section.settings.subtitle | default: 'NATURAL' }}</span>
      <h2 class="section-title">{{ section.settings.title | default: 'Body Care Product' }}</h2>
      <p class="section-desc">
        {{ section.settings.text | default: 'Infused with cold-pressed botanical oils and natural ceramides to nourish your skin barrier with all-day moisture.' }}
      </p>
      <a href="{{ section.settings.btn_link | default: '/collections/body-care' }}" class="btn btn-primary">
        {{ section.settings.btn_label | default: 'DISCOVER MORE' }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promo Banner",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "NATURAL"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Body Care Product"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Infused with cold-pressed botanical oils and natural ceramides to nourish your skin barrier with all-day moisture."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "DISCOVER MORE"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Promo Banner"
    }
  ]
}
{% endschema %}
