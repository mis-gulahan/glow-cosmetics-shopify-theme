<section class="features-bar">
  <div class="container">
    <div class="features-grid">
      <div class="feature-box">
        <div class="feature-icon-wrap">
          {% render 'icon-truck' %}
        </div>
        <div class="feature-info">
          <h4>Free Delivery</h4>
          <p>Free shipping on orders over $50</p>
        </div>
      </div>

      <div class="feature-box">
        <div class="feature-icon-wrap">
          {% render 'icon-headset' %}
        </div>
        <div class="feature-info">
          <h4>24/7 Support</h4>
          <p>Instant expert skincare advice</p>
        </div>
      </div>

      <div class="feature-box">
        <div class="feature-icon-wrap">
          {% render 'icon-leaf' %}
        </div>
        <div class="feature-info">
          <h4>100% Organic</h4>
          <p>Certified pure botanical actives</p>
        </div>
      </div>

      <div class="feature-box">
        <div class="feature-icon-wrap">
          {% render 'icon-shield' %}
        </div>
        <div class="feature-info">
          <h4>Secure Payment</h4>
          <p>Safe SSL encrypted checkout</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Features Bar",
  "settings": [],
  "presets": [
    {
      "name": "Features Bar"
    }
  ]
}
{% endschema %}
