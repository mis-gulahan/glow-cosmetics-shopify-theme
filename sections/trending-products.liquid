<section class="products-section">
  <div class="container">
    <div class="section-header-center">
      <span class="section-tag">{{ section.settings.subtitle | default: 'New Season' }}</span>
      <h2 class="section-title">{{ section.settings.title | default: 'Trending Products' }}</h2>
      
      <!-- Category Tabs -->
      <div class="category-tabs">
        <button type="button" class="category-tab-btn active" data-category="all">All Products</button>
        <button type="button" class="category-tab-btn" data-category="face-care">Face Care</button>
        <button type="button" class="category-tab-btn" data-category="body-care">Body Care</button>
        <button type="button" class="category-tab-btn" data-category="accessories">Accessories</button>
      </div>
    </div>

    <!-- Product Grid -->
    <div class="product-grid trending-grid">
      {%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        <!-- Fallback mock cards matching exact UI design -->
        <div class="product-card" data-category="face-care">
          <div class="card-media-wrap">
            <span class="card-badge">NEW</span>
            <a href="/products/smooth-essen">
              <img src="{{ 'product-bottle-green.svg' | asset_url }}" alt="Smooth Essen">
            </a>
            <div class="card-quick-actions">
              <button type="button" class="action-icon-btn wishlist" title="Wishlist">{% render 'icon-heart' %}</button>
              <button type="button" class="action-icon-btn quickview" title="Quick View">{% render 'icon-search' %}</button>
              <button type="button" class="action-icon-btn cart" title="Add to Cart">{% render 'icon-cart' %}</button>
            </div>
          </div>
          <div class="card-details">
            <h3 class="product-card-title"><a href="/products/smooth-essen">Smooth Essen</a></h3>
            {% render 'rating-stars' %}
            <div class="card-prices"><span class="price-current">$35.73</span></div>
            {% render 'color-swatches' %}
          </div>
        </div>

        <div class="product-card" data-category="face-care">
          <div class="card-media-wrap">
            <a href="/products/urban-decoy">
              <img src="{{ 'product-bottle-blue.svg' | asset_url }}" alt="Urban Decoy">
            </a>
            <div class="card-quick-actions">
              <button type="button" class="action-icon-btn wishlist" title="Wishlist">{% render 'icon-heart' %}</button>
              <button type="button" class="action-icon-btn quickview" title="Quick View">{% render 'icon-search' %}</button>
              <button type="button" class="action-icon-btn cart" title="Add to Cart">{% render 'icon-cart' %}</button>
            </div>
          </div>
          <div class="card-details">
            <h3 class="product-card-title"><a href="/products/urban-decoy">Urban Decoy</a></h3>
            {% render 'rating-stars' %}
            <div class="card-prices"><span class="price-current">$45.00</span></div>
            {% render 'color-swatches' %}
          </div>
        </div>

        <div class="product-card" data-category="body-care">
          <div class="card-media-wrap">
            <span class="card-badge">SALE</span>
            <a href="/products/smoothing-essence">
              <img src="{{ 'product-bottle-rose.svg' | asset_url }}" alt="Smoothing Essence">
            </a>
            <div class="card-quick-actions">
              <button type="button" class="action-icon-btn wishlist" title="Wishlist">{% render 'icon-heart' %}</button>
              <button type="button" class="action-icon-btn quickview" title="Quick View">{% render 'icon-search' %}</button>
              <button type="button" class="action-icon-btn cart" title="Add to Cart">{% render 'icon-cart' %}</button>
            </div>
          </div>
          <div class="card-details">
            <h3 class="product-card-title"><a href="/products/smoothing-essence">Smoothing Essence</a></h3>
            {% render 'rating-stars' %}
            <div class="card-prices">
              <span class="price-compare">$65.00</span>
              <span class="price-current">$50.67</span>
            </div>
            {% render 'color-swatches' %}
          </div>
        </div>

        <div class="product-card" data-category="accessories">
          <div class="card-media-wrap">
            <a href="/products/anti-aging-cream">
              <img src="{{ 'product-bottle-amber.svg' | asset_url }}" alt="Modern Eye Brush">
            </a>
            <div class="card-quick-actions">
              <button type="button" class="action-icon-btn wishlist" title="Wishlist">{% render 'icon-heart' %}</button>
              <button type="button" class="action-icon-btn quickview" title="Quick View">{% render 'icon-search' %}</button>
              <button type="button" class="action-icon-btn cart" title="Add to Cart">{% render 'icon-cart' %}</button>
            </div>
          </div>
          <div class="card-details">
            <h3 class="product-card-title"><a href="/products/anti-aging-cream">Modern Eye Brush</a></h3>
            {% render 'rating-stars' %}
            <div class="card-prices"><span class="price-current">$61.45</span></div>
            {% render 'color-swatches' %}
          </div>
        </div>
      {%- endif -%}
    </div>

    <div style="text-align: center; margin-top: 40px;">
      <a href="/collections/all" class="btn btn-primary">
        {{ section.settings.btn_label | default: 'VIEW ALL PRODUCTS' }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trending Products",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Cursive Subtitle",
      "default": "New Season"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Trending Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 4,
      "label": "Products to show"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "VIEW ALL PRODUCTS"
    }
  ],
  "presets": [
    {
      "name": "Trending Products"
    }
  ]
}
{% endschema %}
